// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Job {
  id          String   @id @default(uuid())
  userId      String
  type        String   // 'terrain' | 'road'
  status      String   // 'queued' | 'processing' | 'completed' | 'failed'
  inputParams Json
  result      Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  terrain     Terrain?
  road        Road?

  @@index([userId])
  @@index([status])
}

model Terrain {
  id            String    @id @default(uuid())
  jobId         String    @unique
  job           Job       @relation(fields: [jobId], references: [id])
  userId        String
  description   String?   @db.Text
  blendFilePath String
  topViewPath   String
  glbFilePath   String?
  metadata      Json?
  createdAt     DateTime  @default(now())
  roads         Road[]
  objects       Objects[]

  @@index([userId])
}

model Road {
  id            String    @id @default(uuid())
  jobId         String    @unique
  job           Job       @relation(fields: [jobId], references: [id])
  terrainId     String
  terrain       Terrain   @relation(fields: [terrainId], references: [id])
  userId        String
  controlPoints Json
  blendFilePath String
  previewPath   String?
  glbFilePath   String?
  widthMeters   Float     @default(1.6)
  metadata      Json?
  createdAt     DateTime  @default(now())
  objects       Objects[]

  @@index([terrainId])
  @@index([userId])
}

model Objects {
  id            String   @id @default(uuid())
  terrainId     String
  terrain       Terrain  @relation(fields: [terrainId], references: [id])
  roadId        String?
  road          Road?    @relation(fields: [roadId], references: [id])
  userId        String

  blendFilePath String
  previewPath   String
  glbFilePath   String?

  objectCount   Int
  metadata      Json?    // 어떤 나무들이 배치되었는지, spawn config 등

  createdAt     DateTime @default(now())

  @@index([terrainId])
  @@index([roadId])
  @@index([userId])
}
